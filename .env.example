# Required credentials: replace both values before use.
VHD_ADMIN_PASSWORD=replace-with-a-strong-admin-password-at-least-12-characters
VHD_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Local development mode keeps HTTP testing and cookies usable on localhost/LAN.
# Set VHD_ENV=production only after HTTPS is configured.
VHD_ENV=development
VHD_COOKIE_SECURE=0
VHD_PORT=5000

# Comma-separated Host/IP values used to access the app.
# Example: localhost,127.0.0.1,192.168.29.46
VHD_ALLOWED_HOSTS=

# Backup retention in days (Phase 6.4)
VHD_BACKUP_RETENTION_DAYS=30

# Audit log retention in days (Phase 6.5)
VHD_AUDIT_RETENTION_DAYS=180

# Required for Vercel production (set in Vercel dashboard, not in source).
DATABASE_URL=
